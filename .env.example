# Required: token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required: comma-separated Telegram user IDs allowed to operate the bot.
# Get yours by messaging @userinfobot, or by sending /chatid in the group.
ALLOWED_USER_IDS=

# Comma-separated Telegram group IDs (negative integers for supergroups).
# May be empty on first boot — the bot will allow /chatid from any chat where
# an allowed user sends it, so you can bootstrap. Fill it in afterwards.
ALLOWED_GROUP_IDS=

# Path to the claude binary. Optional; default below.
# CLAUDE_BIN=/home/claude/.npm-global/bin/claude

# Where the SQLite DB and per-run outputs live. Optional; default ./data
# DATA_DIR=./data

# Logging level. Optional; default INFO.
# LOG_LEVEL=INFO
